{
  "name": "snipeslot",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "concurrently -n web,worker -c blue,green \"npx next dev -H 127.0.0.1 -p 3000\" \"npx tsx watch worker/index.ts\"",
    "dev:web": "next dev -H 127.0.0.1 -p 3000",
    "dev:worker": "tsx watch worker/index.ts",
    "build": "next build",
    "start": "concurrently -n web,worker -c blue,green \"npx next start -H 127.0.0.1 -p 3000\" \"npx tsx worker/index.ts\"",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts"
  },
  "dependencies": {
    "@types/ws": "^8.18.2",
    "cheerio": "^1.0.0",
    "lucide-react": "^0.475.0",
    "next": "^15.2.4",
    "playwright": "^1.51.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "ws": "^8.23.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@tailwindcss/postcss": "^4.0.14",
    "@types/node": "^22.13.10",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "concurrently": "^9.1.2",
    "eslint": "^9.22.0",
    "eslint-config-next": "^15.2.4",
    "tailwindcss": "^4.0.14",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2"
  }
}
